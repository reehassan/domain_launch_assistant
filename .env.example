DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=changeme-generate-a-real-one
DJANGO_ALLOWED_HOSTS=changeme-your-domain-or-server-ip

# --- Postgres ---
# POSTGRES_DB/USER/PASSWORD below are read directly by the `postgres`
# service in docker-compose.yml to initialize the database. DATABASE_URL
# is read separately by Django via dj_database_url — these are NOT
# automatically kept in sync with each other. If you change one, you MUST
# update the other to match, or Django will fail to connect to a database
# that was actually created with different credentials.
POSTGRES_DB=domain_launch_assistant
POSTGRES_USER=dla_user
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgres://dla_user:changeme@postgres:5432/domain_launch_assistant

REDIS_URL=redis://redis:6379/0

# Only relevant for non-compose local dev where the frontend runs on its
# own origin (e.g. `npm run dev` on :5173). In the compose deployment,
# nginx makes frontend and api same-origin, so this isn't consulted.
CORS_ALLOWED_ORIGINS=http://localhost:5173

GEMINI_API_KEY=
GEMINI_MODEL=

# --- name.com: production credentials ---
# Used for real availability/pricing/trademark-claims checks.
NAMECOM_USERNAME=
NAMECOM_API_TOKEN=
NAMECOM_BASE_URL=https://api.name.com/core/v1

# --- name.com: sandbox credentials ---
# Used ONLY for simulated registration and DNS record management
# (architecture.md §7) — a completely separate account/token pair from
# production above. Required, no default — the app will not boot without
# these even if you never exercise the sandbox features.
NAMECOM_TEST_USERNAME=
NAMECOM_TEST_API_TOKEN=
NAMECOM_TEST_BASE_URL=https://api.dev.name.com/core/v1