DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=changeme-generate-a-real-one
DEBUG=True

# For direct-on-host development (running manage.py without Docker).
# If you're using docker-compose instead, use the root-level .env.example
# and its "postgres"/"redis" service hostnames — these localhost values
# won't resolve inside a container.
DATABASE_URL=postgres://dla_user:dla_pass@localhost:5432/domain_launch_assistant
REDIS_URL=redis://localhost:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:5173

GEMINI_API_KEY=
GEMINI_MODEL=

NAMECOM_USERNAME=
NAMECOM_API_TOKEN=

NAMECOM_TEST_USERNAME=
NAMECOM_TEST_API_TOKEN=